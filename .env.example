# Settings for the signup endpoint. Never commit real values.
#
# Locally: copy this file to .dev.vars (same folder) and fill it in.
# On Cloudflare: add each one under Workers & Pages > twist-website > Settings > Variables and Secrets,
# as type "Secret".

# Your Supabase project URL. Supabase > Project Settings > Data API > Project URL.
SUPABASE_URL=https://your-project-ref.supabase.co

# The SECRET server key (starts with sb_secret_, or the older "service_role" key).
# Supabase > Project Settings > API Keys. Never put this in the website's code or share it.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string. Signs the short-lived token that links a popup answer to its signup.
# Make one with: openssl rand -hex 32
SIGNING_SECRET=

# Any long random string, different from the one above. Used to hash visitor IP addresses
# for the rate limit, so raw IPs are never stored. Make one with: openssl rand -hex 16
IP_HASH_SALT=
