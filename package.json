{
  "name": "twist-website",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-dist.mjs",
    "dev": "concurrently -k -n site,api -c blue,magenta \"astro dev\" \"wrangler dev --port 8787\"",
    "build": "astro build",
    "preview": "astro build && wrangler dev --port 8787",
    "deploy": "astro build && wrangler deploy",
    "assets:og": "node scripts/make-og.mjs",
    "fonts": "python3 scripts/subset-fonts.py",
    "qa:screens": "node scripts/qa-screens.mjs"
  },
  "dependencies": {
    "astro": "7.3.5",
    "@astrojs/sitemap": "3.7.4",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "playwright": "1.56.1",
    "wrangler": "4.142.0"
  }
}
