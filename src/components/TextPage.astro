---
// Simple text page (Privacy, Terms) in the site's system.
import Base from '../layouts/Base.astro';
interface Props { title: string; heading: string; description: string }
const { title, heading, description } = Astro.props;
---
<Base title={title} description={description}>
  <section class="text-page" aria-labelledby="tp-h1">
    <div class="wrap">
      <h1 id="tp-h1">{heading}</h1>
      <div class="prose"><slot /></div>
    </div>
  </section>
</Base>

<style>
  .text-page { padding-block: 40px 72px; }
  .wrap { max-width: calc(680px + 2 * var(--gutter)); display: flex; flex-direction: column; gap: 24px; }
  h1 { font-size: 34px; line-height: 1.1; }
  .prose { font-size: 17px; line-height: 1.7; color: var(--ink-muted); }
  @media (min-width: 960px) {
    .text-page { padding-block: 80px 120px; }
    h1 { font-size: clamp(40px, 3.61vw, 52px); }
    .prose { font-size: 18px; }
  }
</style>
